+    expected = {"image", "pixel", "metric_policy", "groups", "pixel_note"} if loco else {"image", "pixel", "metric_policy"}
+    if not isinstance(metrics, dict) or set(metrics) != expected or metrics.get("metric_policy") != METRIC_POLICY:
+        raise ValueError("Saved result dataset-conditioned metric schema or policy differs")
