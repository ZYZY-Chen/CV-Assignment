+        for rule in RULES:
+            pooled, subset = metrics["image"][rule], values["image"][rule]
+            for name in ("threshold_95pct", "normal_fpr"):
+                _metric_equal(subset[name], pooled[name], group + "." + rule + "." + name)
+            _metric_equal(subset["anomaly_recall"], pooled["per_defect_recall"][group], group + "." + rule + ".anomaly_recall")
+    for rule in RULES:
+        weighted = sum(groups[group]["image"][rule]["image_auroc"] * counts[group] for group in LOCO_GROUPS) / total_anomalies
+        _metric_equal(metrics["image"][rule]["image_auroc"], weighted, rule + ".weighted_group_auroc")
+    if metrics["pixel"]["n_positive_pixels"] != sum(groups[group]["pixel"]["n_positive_pixels"] for group in LOCO_GROUPS):
+        raise ValueError("LOCO pooled positive pixels disagree with the two disjoint anomaly groups")
 
 
