+        if not isinstance(values, dict) or set(values) != {"n_good", "n_anomaly", "image", "pixel"}:
+            raise ValueError("LOCO group metric fields differ")
+        if type(values["n_good"]) is not int or type(values["n_anomaly"]) is not int or values["n_good"] != counts["good"] or values["n_anomaly"] != counts[group]:
+            raise ValueError("LOCO metric counts differ from the normal and subgroup sample scope")
+        _validate_image_metrics(values["image"], selected)
