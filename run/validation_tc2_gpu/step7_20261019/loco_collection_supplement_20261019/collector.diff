+def _finite_number(value, field, *, probability=False, metric_roundoff=False):
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ValueError("Saved metric must be a finite non-boolean number: " + field)
+    try:
+        finite = math.isfinite(value)
+    except OverflowError:
+        finite = False
+    if not finite:
+        raise ValueError("Saved metric must be a finite non-boolean number: " + field)
+    # The frozen metric implementation can exceed a boundary by FP64 roundoff.
+    # Preserve those recorded AUROC/AP values within its accepted tolerance.
+    tolerance = 1e-12 if metric_roundoff else 0.0
+    if probability and not -tolerance <= value <= 1 + tolerance:
+        raise ValueError("Saved metric probability is outside [0,1]: " + field)
+    return value
+
+
+def _metric_equal(left, right, field):
+    if abs(left - right) > 1e-12:
+        raise ValueError("Saved pooled and subgroup metrics disagree: " + field)
+
+
+def _sample_counts(items):
+    if not isinstance(items, list) or not items:
+        raise ValueError("Metric validation requires nonempty test samples")
+    counts = {}
+    for item in items:
+        if not isinstance(item, dict) or type(item.get("label")) is not int or item["label"] not in (0, 1):
+            raise ValueError("Metric sample labels must be integer binary labels")
+        defect, size = item.get("defect_type"), item.get("orig_hw")
+        if not isinstance(defect, str) or not defect or (item["label"] == 0) != (defect == "good"):
+            raise ValueError("Metric defect types disagree with sample labels")
+        if not isinstance(size, list) or len(size) != 2 or any(type(value) is not int or value < 1 for value in size):
+            raise ValueError("Metric sample original dimensions are invalid")
+        counts[defect] = counts.get(defect, 0) + 1
+    if not counts.get("good") or not any(defect != "good" for defect in counts):
+        raise ValueError("Metric samples require both normal and anomalous images")
+    return counts
+
+
+def _validate_image_metrics(image, items):
+    counts = _sample_counts(items)
+    if not isinstance(image, dict) or set(image) != RULES:
+        raise ValueError("Saved image metrics must contain exactly the five scoring rules")
+    defects = set(counts) - {"good"}
+    anomalies = sum(counts[defect] for defect in defects)
+    for rule, values in image.items():
+        if not isinstance(values, dict) or set(values) != IMAGE_METRIC_FIELDS:
+            raise ValueError("Saved image metric fields differ")
+        for name in IMAGE_METRIC_FIELDS - {"per_defect_recall"}:
+            _finite_number(values[name], rule + "." + name, probability=name != "threshold_95pct",
+                           metric_roundoff=name in ("image_auroc", "image_ap"))
+        per_defect = values["per_defect_recall"]
+        if not isinstance(per_defect, dict) or set(per_defect) != defects:
+            raise ValueError("Saved per-defect recall groups differ from samples")
+        for defect, value in per_defect.items():
+            _finite_number(value, rule + ".per_defect_recall." + defect, probability=True)
+            if abs(value * counts[defect] - round(value * counts[defect])) > 1e-9:
+                raise ValueError("Saved defect recall is inconsistent with an integer image count")
+        for field, count in (("normal_fpr", counts["good"]), ("anomaly_recall", anomalies)):
+            value = values[field] * count
+            if abs(value - round(value)) > 1e-9:
+                raise ValueError("Saved image rate is inconsistent with an integer image count")
+        weighted = sum(per_defect[defect] * counts[defect] for defect in defects) / anomalies
+        _metric_equal(values["anomaly_recall"], weighted, rule + ".anomaly_recall")
+    return counts
+
+
+def _validate_pixel_metrics(pixel, items):
+    if not isinstance(pixel, dict) or set(pixel) != PIXEL_METRIC_FIELDS:
+        raise ValueError("Saved pixel metric fields differ")
+    for name in ("pixel_auroc", "pixel_ap"):
+        _finite_number(pixel[name], name, probability=True, metric_roundoff=True)
+    total = sum(item["orig_hw"][0] * item["orig_hw"][1] for item in items)
+    anomaly_pixels = sum(item["orig_hw"][0] * item["orig_hw"][1] for item in items if item["label"] == 1)
+    if type(pixel["n_pixels"]) is not int or pixel["n_pixels"] != total:
+        raise ValueError("Saved pixel count differs from original test dimensions")
+    positive = pixel["n_positive_pixels"]
+    if type(positive) is not int or not 0 < positive < total or positive > anomaly_pixels:
+        raise ValueError("Saved positive pixel count differs from the sample scope")
+
