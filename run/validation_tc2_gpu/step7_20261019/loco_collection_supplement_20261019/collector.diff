+def _validate_result_metrics(metrics, cfg, samples):
+    """Validate recorded LOCO group semantics without reading prediction arrays."""
+    if not isinstance(cfg, dict) or cfg.get("dataset") not in CATEGORIES:
+        raise ValueError("Metric dataset is outside the frozen protocol")
+    if not isinstance(samples, dict):
+        raise ValueError("Metric sample record must be a dictionary")
+    items = samples.get("test")
